    { "id": "child_welfare_youth_services", "label": "Child & youth", "status": "new_controlled_lane", "examples": ["child protection", "foster care", "youth services", "advocate investigations", "family-service funding"] },
    { "id": "housing_homelessness", "label": "Housing", "status": "new_controlled_lane", "examples": ["public housing", "tenancy discrimination", "shelter systems", "supportive housing", "homelessness services"] },
