# Server-only OpenAI credential and optional model names.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REVIEW_MODEL=

# Server-only Tavily credential.
TAVILY_API_KEY=

# Optional server-only TransLink GTFS-realtime key. Static GTFS needs no key.
TRANSLINK_GTFS_REALTIME_API_KEY=

# Supabase project origin and server-only service-role credential.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only attachment scanner prototype. Never copy a production URL or key
# into these variables. Obtain the local values from your local Supabase stack.
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOCAL_SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated, server-only list of Supabase Auth email addresses authorized as Miller administrators.
ADMIN_EMAIL_ALLOWLIST=

# Dedicated read-only Miller -> Samwise Status Adapter credential. Configure a
# high-entropy value only in the server/deployment secret store; never reuse an
# administrator, Supabase, scheduler, or provider credential.
SAMWISE_STATUS_TOKEN=

# Dedicated localhost-only Samwise prepared-publication conveyor. This is a
# separate high-entropy transport secret: it authorizes only list/confirm of
# already-prepared publish_verified_map_pin actions, never a general API or
# database access. Configure the matching value only in Samwise's owner-local
# runtime configuration. Restart both local processes after rotation.
MILLER_SAMWISE_CONVEYOR_TOKEN=
MILLER_SAMWISE_CONVEYOR_PORT=8791
# Existing Miller administrator UUID used solely as the audited actor for the
# existing publication RPC. It is not a credential and must not be supplied by
# Samwise or ChatGPT.
MILLER_PREPARED_PUBLICATION_ACTOR_ID=
MILLER_PREPARED_PUBLICATION_DB_PATH=

# Comma-separated exact frontend origins allowed to call Express when frontend and backend use different origins.
CORS_ALLOWED_ORIGINS=

# Public paid-search safeguards. Limits are enforced in one server process.
MILLER_RATE_LIMIT_PER_MINUTE=8
PAID_OPERATIONS_DAILY_LIMIT=500
PROVIDER_TIMEOUT_MS=20000

# Feature flag for server-side AI resource review.
AI_REVIEW_ENABLED=

# Local-only, manual derived-state maintenance. This remains disabled unless the
# server is also configured against a loopback Supabase URL.
MILLER_QUIET_MAINTENANCE_LOCAL_ONLY=

# Express runtime configuration.
PORT=
NODE_ENV=
# Local development binds to loopback by default. Set these explicitly only
# when deliberate LAN access is needed; production hosting keeps its platform
# managed bind when MILLER_BIND_HOST is blank.
MILLER_BIND_HOST=
MILLER_VITE_HOST=
MILLER_VITE_PORT=5173
